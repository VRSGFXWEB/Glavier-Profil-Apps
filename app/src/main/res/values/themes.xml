<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Glacier" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/glacier_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Glacier.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/glacier_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Glacier</item>
    </style>
</resources>
